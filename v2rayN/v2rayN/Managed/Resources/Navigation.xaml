<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ManagedNavigationRadioStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Foreground" Value="{DynamicResource ManagedBrushTextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource ManagedFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="NavigationBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{DynamicResource ManagedRadiusPill}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource ManagedBrushBgBubble}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource ManagedBrushPrimary100}" />
                            <Setter Property="Foreground" Value="{DynamicResource ManagedBrushPrimary600}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="{DynamicResource ManagedBrushInfo}" />
                            <Setter TargetName="NavigationBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
