<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Managed Accessibility Resources
        ================================
        Focus visuals, high-contrast overrides, and screen-reader support
        for the NetAccel managed WPF client.

        All focus indicators use ManagedBrushFocusIndicator (mapped to
        ManagedColorFocusIndicator in Colors.xaml / Colors.Dark.xaml) so
        they automatically adapt to the active theme.
    -->

    <!-- ── Focus Visual: thick outline for keyboard navigation ────────── -->
    <Style x:Key="ManagedFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        x:Name="FocusBorder"
                        Margin="-4"
                        Padding="2"
                        BorderBrush="{DynamicResource ManagedBrushFocusIndicator}"
                        BorderThickness="3"
                        CornerRadius="{DynamicResource ManagedRadiusSmall}"
                        SnapsToDevicePixels="True">
                        <Border
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ManagedRadiusSmall}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alias used on controls that reference FocusVisualStyle directly -->
    <Style
        x:Key="ManagedFocusVisual"
        BasedOn="{StaticResource ManagedFocusVisualStyle}"
        TargetType="{x:Type Control}" />

    <!-- Button / toggle focus: 3px primary-color ring outside the element -->
    <Style x:Key="ManagedButtonFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        Margin="-4"
                        BorderBrush="{DynamicResource ManagedBrushFocusIndicator}"
                        BorderThickness="3"
                        CornerRadius="{DynamicResource ManagedRadiusPill}"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox / ComboBox focus: slightly inset so it doesn't clip border -->
    <Style x:Key="ManagedInputFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        Margin="-3"
                        BorderBrush="{DynamicResource ManagedBrushFocusIndicator}"
                        BorderThickness="2.5"
                        CornerRadius="{DynamicResource ManagedRadiusSmall}"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- High-contrast focus visual: uses system highlight color, thicker line -->
    <Style x:Key="ManagedHighContrastFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border
                        Margin="-4"
                        Padding="2"
                        BorderBrush="{x:Static SystemColors.HighlightBrush}"
                        BorderThickness="3"
                        CornerRadius="0"
                        SnapsToDevicePixels="True">
                        <Border
                            BorderBrush="{x:Static SystemColors.HighlightTextBrush}"
                            BorderThickness="1"
                            CornerRadius="0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Screen-reader friendly hidden text styles ───────────────────── -->

    <!--
        Use ManagedScreenReaderOnly on TextBlock / Label elements that
        provide context only to assistive technology (e.g. decorative icon
        descriptions, form field labels hidden visually).
        The element is collapsed visually but remains in the automation tree.
    -->
    <Style x:Key="ManagedScreenReaderOnly" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="-1" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Clip" Value="M0,0 L1,0 1,1 0,1 Z" />
    </Style>

    <!--
        ManagedAutomationNameHelper: an attached-property-friendly style
        for adding AutomationProperties.Name via XAML without code-behind.
        Apply this style to elements and set AutomationProperties.Name in XAML.
    -->
    <Style x:Key="ManagedAccessibleElement" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
    </Style>

    <!-- ── Overlay panel for modal dialogs ─────────────────────────────── -->
    <Style x:Key="ManagedOverlayStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ManagedBrushOverlay}" />
    </Style>

    <!-- ── Drop-shadow effect for elevated cards ───────────────────────── -->
    <Style x:Key="ManagedCardElevatedStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ManagedBrushBgSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ManagedBrushBorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ManagedRadiusLarge}" />
        <Setter Property="Padding" Value="{DynamicResource ManagedCardPadding}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="12"
                    Color="{DynamicResource ManagedColorShadow}"
                    Direction="270"
                    Opacity="1"
                    ShadowDepth="3" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
