<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ManagedColorBgCanvas">#F5F7F6</Color>
    <Color x:Key="ManagedColorBgSurface">#FFFFFF</Color>
    <Color x:Key="ManagedColorBgBubble">#EDF7F3</Color>
    <Color x:Key="ManagedColorBgBubbleHover">#E3F2EC</Color>
    <Color x:Key="ManagedColorPrimary500">#2AAE82</Color>
    <Color x:Key="ManagedColorPrimary600">#218C6A</Color>
    <Color x:Key="ManagedColorPrimary100">#DDF3EA</Color>
    <Color x:Key="ManagedColorTextPrimary">#17211D</Color>
    <Color x:Key="ManagedColorTextSecondary">#66736D</Color>
    <Color x:Key="ManagedColorTextDisabled">#A0AAA5</Color>
    <Color x:Key="ManagedColorBorderDefault">#DDE6E1</Color>
    <Color x:Key="ManagedColorSuccess">#2A9D6F</Color>
    <Color x:Key="ManagedColorWarning">#D4932F</Color>
    <Color x:Key="ManagedColorDanger">#D85B5B</Color>
    <Color x:Key="ManagedColorInfo">#4A86D4</Color>
    <Color x:Key="ManagedColorSuccessSurface">#E4F5ED</Color>
    <Color x:Key="ManagedColorWarningSurface">#FFF3DF</Color>
    <Color x:Key="ManagedColorDangerSurface">#FBE9E9</Color>
    <Color x:Key="ManagedColorInfoSurface">#EAF2FC</Color>

    <SolidColorBrush x:Key="ManagedBrushBgCanvas" Color="{StaticResource ManagedColorBgCanvas}" />
    <SolidColorBrush x:Key="ManagedBrushBgSurface" Color="{StaticResource ManagedColorBgSurface}" />
    <SolidColorBrush x:Key="ManagedBrushBgBubble" Color="{StaticResource ManagedColorBgBubble}" />
    <SolidColorBrush x:Key="ManagedBrushBgBubbleHover" Color="{StaticResource ManagedColorBgBubbleHover}" />
    <SolidColorBrush x:Key="ManagedBrushPrimary500" Color="{StaticResource ManagedColorPrimary500}" />
    <SolidColorBrush x:Key="ManagedBrushPrimary600" Color="{StaticResource ManagedColorPrimary600}" />
    <SolidColorBrush x:Key="ManagedBrushPrimary100" Color="{StaticResource ManagedColorPrimary100}" />
    <SolidColorBrush x:Key="ManagedBrushTextPrimary" Color="{StaticResource ManagedColorTextPrimary}" />
    <SolidColorBrush x:Key="ManagedBrushTextSecondary" Color="{StaticResource ManagedColorTextSecondary}" />
    <SolidColorBrush x:Key="ManagedBrushTextDisabled" Color="{StaticResource ManagedColorTextDisabled}" />
    <SolidColorBrush x:Key="ManagedBrushBorderDefault" Color="{StaticResource ManagedColorBorderDefault}" />
    <SolidColorBrush x:Key="ManagedBrushSuccess" Color="{StaticResource ManagedColorSuccess}" />
    <SolidColorBrush x:Key="ManagedBrushWarning" Color="{StaticResource ManagedColorWarning}" />
    <SolidColorBrush x:Key="ManagedBrushDanger" Color="{StaticResource ManagedColorDanger}" />
    <SolidColorBrush x:Key="ManagedBrushInfo" Color="{StaticResource ManagedColorInfo}" />
    <SolidColorBrush x:Key="ManagedBrushSuccessSurface" Color="{StaticResource ManagedColorSuccessSurface}" />
    <SolidColorBrush x:Key="ManagedBrushWarningSurface" Color="{StaticResource ManagedColorWarningSurface}" />
    <SolidColorBrush x:Key="ManagedBrushDangerSurface" Color="{StaticResource ManagedColorDangerSurface}" />
    <SolidColorBrush x:Key="ManagedBrushInfoSurface" Color="{StaticResource ManagedColorInfoSurface}" />
</ResourceDictionary>
