<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        NetAccel Tray Icon Templates — 4 states for system tray notification area.

        These are ControlTemplate resources intended for use with WPF DrawingVisual
        rendering or as direct icon sources. Each template defines a 32x32 vector
        that scales to any tray icon size (16px typical).

        States:
          NetAccelTrayIdle       — muted shield outline (disconnected / standby)
          NetAccelTrayConnected  — filled green shield with checkmark
          NetAccelTrayFaulted    — shield with red warning indicator
          NetAccelTrayStarting   — shield with animated green pulse
    -->

    <!-- ============================================================ -->
    <!-- IDLE STATE: muted shield outline, secondary text color -->
    <!-- ============================================================ -->
    <DrawingImage x:Key="NetAccelTrayIdle">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Shield outline, muted color -->
                <GeometryDrawing
                    Brush="Transparent"
                    Geometry="M 16,2
                              C 16,2 8,2 6,4
                              C 4,6 3,9 3,12
                              C 3,16 5,22 10,26
                              C 12,27.5 14,28.5 16,29
                              C 18,28.5 20,27.5 22,26
                              C 27,22 29,16 29,12
                              C 29,9 28,6 26,4
                              C 24,2 16,2 16,2 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource ManagedBrushTextSecondary}" Thickness="2.5" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Small horizontal dash in center (neutral indicator) -->
                <GeometryDrawing
                    Brush="{DynamicResource ManagedBrushTextSecondary}"
                    Geometry="M 12,15.5 L 20,15.5 L 20,17.5 L 12,17.5 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============================================================ -->
    <!-- CONNECTED STATE: bright green filled shield + checkmark -->
    <!-- ============================================================ -->
    <DrawingImage x:Key="NetAccelTrayConnected">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Filled shield, primary green -->
                <GeometryDrawing
                    Brush="{DynamicResource ManagedBrushPrimary500}"
                    Geometry="M 16,2
                              C 16,2 8,2 6,4
                              C 4,6 3,9 3,12
                              C 3,16 5,22 10,26
                              C 12,27.5 14,28.5 16,29
                              C 18,28.5 20,27.5 22,26
                              C 27,22 29,16 29,12
                              C 29,9 28,6 26,4
                              C 24,2 16,2 16,2 Z" />
                <!-- Checkmark (white) -->
                <GeometryDrawing
                    Brush="#FFFFFFFF"
                    Geometry="M 11.5,15.5
                              L 14.5,18.5
                              L 21,12
                              L 19.5,10.5
                              L 14.5,15.5
                              L 13,14
                              Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============================================================ -->
    <!-- FAULTED STATE: shield outline + red warning exclamation -->
    <!-- ============================================================ -->
    <DrawingImage x:Key="NetAccelTrayFaulted">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Shield outline, danger red -->
                <GeometryDrawing
                    Brush="{DynamicResource ManagedBrushDanger}"
                    Geometry="M 16,2
                              C 16,2 8,2 6,4
                              C 4,6 3,9 3,12
                              C 3,16 5,22 10,26
                              C 12,27.5 14,28.5 16,29
                              C 18,28.5 20,27.5 22,26
                              C 27,22 29,16 29,12
                              C 29,9 28,6 26,4
                              C 24,2 16,2 16,2 Z" />
                <!-- Exclamation mark (vertical bar) -->
                <GeometryDrawing
                    Brush="#FFFFFFFF"
                    Geometry="M 14.5,10
                              L 17.5,10
                              L 17.5,18
                              L 14.5,18
                              Z" />
                <!-- Exclamation mark (dot) -->
                <GeometryDrawing
                    Brush="#FFFFFFFF"
                    Geometry="M 14.5,20
                              L 17.5,20
                              L 17.5,23
                              L 14.5,23
                              Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============================================================ -->
    <!-- STARTING STATE: shield with animated pulse ring -->
    <!-- ============================================================ -->
    <DrawingImage x:Key="NetAccelTrayStartingBase">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Pulse ring (will be animated via opacity) -->
                <GeometryDrawing
                    Brush="{DynamicResource ManagedBrushPrimary100}"
                    Geometry="M 16,0
                              C 16,0 6,0 4,2.5
                              C 2,5 0.5,9 0.5,12.5
                              C 0.5,17 3,24 9.5,28
                              C 12,29.5 14.5,30.5 16,31
                              C 17.5,30.5 20,29.5 22.5,28
                              C 29,24 31.5,17 31.5,12.5
                              C 31.5,9 30,5 28,2.5
                              C 26,0 16,0 16,0 Z" />
                <!-- Solid shield, primary green -->
                <GeometryDrawing
                    Brush="{DynamicResource ManagedBrushPrimary500}"
                    Geometry="M 16,2
                              C 16,2 8,2 6,4
                              C 4,6 3,9 3,12
                              C 3,16 5,22 10,26
                              C 12,27.5 14,28.5 16,29
                              C 18,28.5 20,27.5 22,26
                              C 27,22 29,16 29,12
                              C 29,9 28,6 26,4
                              C 24,2 16,2 16,2 Z" />
                <!-- Small lightning bolt (white) -->
                <GeometryDrawing
                    Brush="#FFFFFFFF"
                    Geometry="M 18,8
                              L 13.5,15.5
                              L 16.5,15.5
                              L 14,24
                              L 20.5,15
                              L 17.5,15
                              L 19.5,8
                              Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
