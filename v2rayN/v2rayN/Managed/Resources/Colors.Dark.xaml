    <Color x:Key="ManagedColorOverlay">#CC101613</Color>
    <Color x:Key="ManagedColorShadow">#40000000</Color>

    <SolidColorBrush x:Key="ManagedBrushBgCanvas" Color="{StaticResource ManagedColorBgCanvas}" />
