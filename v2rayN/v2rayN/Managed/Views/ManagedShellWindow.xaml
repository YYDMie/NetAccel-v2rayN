<Window
    x:Class="v2rayN.Managed.Views.ManagedShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:v2rayN.Managed.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:v2rayN.Managed.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NetAccel"
    Width="820"
    Height="620"
    MinWidth="720"
    MinHeight="560"
    Background="{DynamicResource ManagedBrushBgCanvas}"
    FontFamily="{DynamicResource ManagedFontFamily}"
    Icon="/Resources/v2rayN.ico"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="24,0"
            Background="{DynamicResource ManagedBrushBgSurface}"
            BorderBrush="{DynamicResource ManagedBrushBorderDefault}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="34"
                        Height="34"
                        Background="{DynamicResource ManagedBrushPrimary100}"
                        CornerRadius="{DynamicResource ManagedRadiusMedium}">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ManagedBrushPrimary600}"
                            Kind="ShieldCheckOutline" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ManagedBrushTextPrimary}"
                        Text="NetAccel" />
                </StackPanel>
                <controls:StatusBubble
                    x:Name="ShellStatus"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="正在准备"
                    Tone="Info" />
            </Grid>
        </Border>

        <Grid
            x:Name="ShellContent"
            Grid.Row="1"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource ManagedNavWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="12,18"
                Background="{DynamicResource ManagedBrushBgSurface}"
                BorderBrush="{DynamicResource ManagedBrushBorderDefault}"
                BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <RadioButton
                        x:Name="DiagnosticsNavigation"
                        DockPanel.Dock="Bottom"
                        GroupName="ManagedNavigation"
                        Style="{DynamicResource ManagedNavigationRadioStyle}"
                        Tag="Diagnostics">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" Kind="Lifebuoy" />
                            <TextBlock Margin="10,0,0,0" Text="诊断" />
                        </StackPanel>
                    </RadioButton>

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton
                            x:Name="HomeNavigation"
                            GroupName="ManagedNavigation"
                            IsChecked="True"
                            Style="{DynamicResource ManagedNavigationRadioStyle}"
                            Tag="Home">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="HomeOutline" />
                                <TextBlock Margin="10,0,0,0" Text="首页" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="RoutesNavigation"
                            GroupName="ManagedNavigation"
                            Style="{DynamicResource ManagedNavigationRadioStyle}"
                            Tag="Routes">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="MapMarkerPath" />
                                <TextBlock Margin="10,0,0,0" Text="线路" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="ActivityNavigation"
                            GroupName="ManagedNavigation"
                            Style="{DynamicResource ManagedNavigationRadioStyle}"
                            Tag="Activity">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="History" />
                                <TextBlock Margin="10,0,0,0" Text="记录" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="SettingsNavigation"
                            GroupName="ManagedNavigation"
                            Style="{DynamicResource ManagedNavigationRadioStyle}"
                            Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="CogOutline" />
                                <TextBlock Margin="10,0,0,0" Text="设置" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid
                    MaxWidth="{DynamicResource ManagedContentMaxWidth}"
                    Margin="{DynamicResource ManagedWindowPageMargin}"
                    HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            x:Name="PageTitle"
                            Style="{DynamicResource ManagedPageTitleTextStyle}"
                            Text="首页" />
                        <TextBlock
                            x:Name="PageSubtitle"
                            Margin="0,6,0,0"
                            Style="{DynamicResource ManagedSecondaryTextStyle}"
                            Text="查看状态并开始网络加速。" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,24,0,0">
                        <StackPanel x:Name="HomeSection">
                            <controls:BubbleCard
                                Description="{Binding Detail}"
                                IsHighlighted="True"
                                Title="{Binding RouteName}">
                                <StackPanel HorizontalAlignment="Center">
                                    <controls:ConnectOrb
                                        x:Name="ConnectionOrb"
                                        AutomationProperties.Name="一键加速"
                                        ActionText="{Binding ActionText}"
                                        Click="ConnectionOrb_Click"
                                        IsEnabled="{Binding IsActionEnabled}"
                                        StatusText="{Binding StatusText}" />
                                    <WrapPanel Margin="0,22,0,0" HorizontalAlignment="Center">
                                        <controls:StatusBubble Margin="4" Text="状态" Value="{Binding StatusText}" />
                                        <controls:StatusBubble Margin="4" Text="延迟" Value="--" />
                                        <controls:StatusBubble Margin="4" Text="稳定" Value="--" />
                                    </WrapPanel>
                                    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <RadioButton
                                            x:Name="SystemProxyMode"
                                            AutomationProperties.Name="智能加速"
                                            Content="智能加速"
                                            IsChecked="{Binding IsSystemProxyMode, Mode=OneWay}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                            Click="SystemProxyMode_Click"
                                            Style="{DynamicResource ManagedNavigationRadioStyle}" />
                                        <RadioButton
                                            x:Name="TunMode"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="全局加速"
                                            Content="全局加速"
                                            IsChecked="{Binding IsTunMode, Mode=OneWay}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                            Click="TunMode_Click"
                                            Style="{DynamicResource ManagedNavigationRadioStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:BubbleCard>
                        </StackPanel>

                        <StackPanel
                            x:Name="RoutesSection"
                            Visibility="Collapsed">
                            <controls:BubbleCard
                                Description="根据推荐和当前网络自动选择，不会显示未分配线路。"
                                Title="智能选择">
                                <controls:RouteBubble
                                    AutomationProperties.Name="智能选择"
                                    Click="AutomaticRoute_Click"
                                    DisplayName="智能选择"
                                    IsEnabled="{Binding IsSelectionEnabled}"
                                    IsRecommended="True"
                                    IsSelected="{Binding AutomaticSelected}"
                                    Region="自动选择已分配线路"
                                    StatusText="推荐" />
                            </controls:BubbleCard>

                            <controls:BubbleCard
                                Margin="0,16,0,0"
                                Description="维护中或当前设备不支持的线路会自动禁用。"
                                Title="已分配线路">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Routes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:RouteBubble
                                                    Margin="0,0,0,8"
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    Click="RouteBubble_Click"
                                                    DisplayName="{Binding DisplayName}"
                                                    IsEnabled="{Binding IsSelectable}"
                                                    IsRecommended="{Binding IsRecommended}"
                                                    IsSelected="{Binding IsSelected}"
                                                    Region="{Binding Region}"
                                                    StatusText="{Binding StatusText}"
                                                    Tag="{Binding Id}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{DynamicResource ManagedSecondaryTextStyle}"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />
                                    <controls:PillButton
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="重新检查线路"
                                        Click="RefreshRoutes_Click"
                                        Content="重新检查"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                </StackPanel>
                            </controls:BubbleCard>
                        </StackPanel>

                        <StackPanel
                            x:Name="ActivitySection"
                            Visibility="Collapsed">
                            <controls:BubbleCard
                                Description="只显示连接、停止、恢复和失败等用户事件。"
                                Title="最近记录">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="16,12"
                                                    Background="{DynamicResource ManagedBrushBgBubble}"
                                                    CornerRadius="{DynamicResource ManagedRadiusMedium}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock
                                                                Style="{DynamicResource ManagedCardTitleTextStyle}"
                                                                Text="{Binding Title}" />
                                                            <TextBlock
                                                                Margin="0,4,0,0"
                                                                Style="{DynamicResource ManagedSecondaryTextStyle}"
                                                                Text="{Binding Detail}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="16,0,0,0"
                                                            VerticalAlignment="Top"
                                                            Style="{DynamicResource ManagedSecondaryTextStyle}"
                                                            Text="{Binding TimeText}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Text="{Binding EmptyMessage}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style
                                                BasedOn="{StaticResource ManagedSecondaryTextStyle}"
                                                TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <controls:PillButton
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="查看详细日志"
                                        Click="OpenDetailedLogs_Click"
                                        Content="查看详细日志" />
                                </StackPanel>
                            </controls:BubbleCard>
                        </StackPanel>

                        <controls:BubbleCard
                            x:Name="PlaceholderSection"
                            Description="页面结构已经预留，具体功能将在后续 R3 子任务中接入。"
                            Title="正在准备"
                            Visibility="Collapsed">
                            <TextBlock
                                Style="{DynamicResource ManagedBodyTextStyle}"
                                Text="这里会保持简洁，只展示完成当前任务需要的信息。" />
                        </controls:BubbleCard>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <local:ManagedLoginView
            x:Name="LoginView"
            Grid.Row="1" />
    </Grid>
</Window>
