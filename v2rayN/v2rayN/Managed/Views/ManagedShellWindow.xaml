<Window
    x:Class="v2rayN.Managed.Views.ManagedShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:v2rayN.Managed.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:v2rayN.Managed.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    Title="NetAccel"
    Width="820"
    Height="620"
    MinWidth="720"
    MinHeight="560"
    AutomationProperties.Name="NetAccel 加速客户端"
    Background="{DynamicResource ManagedBrushBgCanvas}"
    FontFamily="{DynamicResource ManagedFontFamily}"
    Icon="pack://application:,,,/NetAccel;component/Resources/NetAccel.ico"
    IsTabStop="True"
    KeyboardNavigation.TabNavigation="Cycle"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="24,0"
            Background="{DynamicResource ManagedBrushBgSurface}"
            BorderBrush="{DynamicResource ManagedBrushBorderDefault}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    VerticalAlignment="Center"
                    AutomationProperties.Name="NetAccel 标识"
                    Orientation="Horizontal">
                    <Border
                        Width="34"
                        Height="34"
                        Background="{DynamicResource ManagedBrushPrimary100}"
                        CornerRadius="{DynamicResource ManagedRadiusMedium}">
                        <Image
                            x:Name="BrandIcon"
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{DynamicResource NetAccelIcon}" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ManagedBrushTextPrimary}"
                        Text="NetAccel" />
                </StackPanel>
                <controls:StatusBubble
                    x:Name="ShellStatus"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Text="正在准备"
                    Tone="Info" />
            </Grid>
        </Border>

        <Grid
            x:Name="ShellContent"
            Grid.Row="1"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource ManagedNavWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="12,18"
                Background="{DynamicResource ManagedBrushBgSurface}"
                BorderBrush="{DynamicResource ManagedBrushBorderDefault}"
                BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <RadioButton
                        x:Name="DiagnosticsNavigation"
                        TabIndex="4"
                        AutomationProperties.Name="诊断导航"
                        DockPanel.Dock="Bottom"
                        GroupName="ManagedNavigation"
                        IsTabStop="True"
                        Style="{DynamicResource ManagedNavigationRadioStyle}"
                        Tag="Diagnostics">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="18" Height="18" Kind="Lifebuoy" />
                            <TextBlock Margin="10,0,0,0" Text="诊断" />
                        </StackPanel>
                    </RadioButton>

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton
                            x:Name="HomeNavigation"
                            TabIndex="0"
                            AutomationProperties.Name="首页导航"
                            GroupName="ManagedNavigation"
                            IsChecked="True"
                            IsTabStop="True"
                            Style="{DynamicResource ManagedNavigationRadioStyle}"
                            Tag="Home">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="HomeOutline" />
                                <TextBlock Margin="10,0,0,0" Text="首页" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="RoutesNavigation"
                            TabIndex="1"
                            AutomationProperties.Name="线路导航"
                            GroupName="ManagedNavigation"
                            IsTabStop="True"
                            Style="{DynamicResource ManagedNavigationRadioStyle}"
                            Tag="Routes">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="MapMarkerPath" />
                                <TextBlock Margin="10,0,0,0" Text="线路" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="ActivityNavigation"
                            TabIndex="2"
                            AutomationProperties.Name="记录导航"
                            GroupName="ManagedNavigation"
                            IsTabStop="True"
                            Style="{DynamicResource ManagedNavigationRadioStyle}"
                            Tag="Activity">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="History" />
                                <TextBlock Margin="10,0,0,0" Text="记录" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            x:Name="SettingsNavigation"
                            TabIndex="3"
                            AutomationProperties.Name="设置导航"
                            GroupName="ManagedNavigation"
                            IsTabStop="True"
                            Style="{DynamicResource ManagedNavigationRadioStyle}"
                            Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Kind="CogOutline" />
                                <TextBlock Margin="10,0,0,0" Text="设置" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid
                    MaxWidth="{DynamicResource ManagedContentMaxWidth}"
                    Margin="{DynamicResource ManagedWindowPageMargin}"
                    HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            x:Name="PageTitle"
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{DynamicResource ManagedPageTitleTextStyle}"
                            Text="首页" />
                        <TextBlock
                            x:Name="PageSubtitle"
                            Margin="0,6,0,0"
                            Style="{DynamicResource ManagedSecondaryTextStyle}"
                            Text="查看状态并开始网络加速。" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,24,0,0">
                        <StackPanel x:Name="HomeSection">
                            <controls:BubbleCard
                                Description="{Binding Detail}"
                                IsHighlighted="True"
                                Title="{Binding RouteName}">
                                <StackPanel HorizontalAlignment="Center">
                                    <controls:ConnectOrb
                                        x:Name="ConnectionOrb"
                                        AutomationProperties.Name="一键加速"
                                        AutomationProperties.HelpText="按 Enter 或空格开始或停止网络加速"
                                        ActionText="{Binding ActionText}"
                                        Click="ConnectionOrb_Click"
                                        IsEnabled="{Binding IsActionEnabled}"
                                        StatusText="{Binding StatusText}" />
                                    <WrapPanel Margin="0,22,0,0" HorizontalAlignment="Center">
                                        <controls:StatusBubble Margin="4" Text="状态" Value="{Binding StatusText}" />
                                        <controls:StatusBubble Margin="4" Text="延迟" Value="--" />
                                        <controls:StatusBubble Margin="4" Text="稳定" Value="--" />
                                    </WrapPanel>
                                    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <RadioButton
                                            x:Name="SystemProxyMode"
                                            AutomationProperties.Name="智能加速"
                                            Content="智能加速"
                                            IsChecked="{Binding IsSystemProxyMode, Mode=OneWay}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                            Click="SystemProxyMode_Click"
                                            Style="{DynamicResource ManagedNavigationRadioStyle}" />
                                        <RadioButton
                                            x:Name="TunMode"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="全局加速"
                                            Content="全局加速"
                                            IsChecked="{Binding IsTunMode, Mode=OneWay}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                            Click="TunMode_Click"
                                            Style="{DynamicResource ManagedNavigationRadioStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:BubbleCard>
                        </StackPanel>

                        <StackPanel
                            x:Name="RoutesSection"
                            Visibility="Collapsed">
                            <controls:BubbleCard
                                Description="根据推荐和当前网络自动选择，不会显示未分配线路。"
                                Title="智能选择">
                                <controls:RouteBubble
                                    AutomationProperties.Name="智能选择"
                                    Click="AutomaticRoute_Click"
                                    DisplayName="智能选择"
                                    IsEnabled="{Binding IsSelectionEnabled}"
                                    IsRecommended="True"
                                    IsSelected="{Binding AutomaticSelected}"
                                    Region="自动选择已分配线路"
                                    StatusText="推荐" />
                            </controls:BubbleCard>

                            <controls:BubbleCard
                                Margin="0,16,0,0"
                                Description="维护中或当前设备不支持的线路会自动禁用。"
                                Title="已分配线路">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Routes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:RouteBubble
                                                    Margin="0,0,0,8"
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    Click="RouteBubble_Click"
                                                    DisplayName="{Binding DisplayName}"
                                                    IsEnabled="{Binding IsSelectable}"
                                                    IsRecommended="{Binding IsRecommended}"
                                                    IsSelected="{Binding IsSelected}"
                                                    Region="{Binding Region}"
                                                    StatusText="{Binding StatusText}"
                                                    Tag="{Binding Id}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{DynamicResource ManagedSecondaryTextStyle}"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />
                                    <controls:PillButton
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="重新检查线路"
                                        Click="RefreshRoutes_Click"
                                        Content="重新检查"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                </StackPanel>
                            </controls:BubbleCard>
                        </StackPanel>

                        <StackPanel
                            x:Name="ActivitySection"
                            Visibility="Collapsed">
                            <controls:BubbleCard
                                Description="只显示连接、停止、恢复和失败等用户事件。"
                                Title="最近记录">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="16,12"
                                                    Background="{DynamicResource ManagedBrushBgBubble}"
                                                    CornerRadius="{DynamicResource ManagedRadiusMedium}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock
                                                                Style="{DynamicResource ManagedCardTitleTextStyle}"
                                                                Text="{Binding Title}" />
                                                            <TextBlock
                                                                Margin="0,4,0,0"
                                                                Style="{DynamicResource ManagedSecondaryTextStyle}"
                                                                Text="{Binding Detail}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="16,0,0,0"
                                                            VerticalAlignment="Top"
                                                            Style="{DynamicResource ManagedSecondaryTextStyle}"
                                                            Text="{Binding TimeText}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Text="{Binding EmptyMessage}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style
                                                BasedOn="{StaticResource ManagedSecondaryTextStyle}"
                                                TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <controls:PillButton
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="查看详细日志"
                                        Click="OpenDetailedLogs_Click"
                                        Content="查看详细日志" />
                                </StackPanel>
                            </controls:BubbleCard>
                        </StackPanel>

                        <StackPanel
                            x:Name="DiagnosticsSection"
                            Visibility="Collapsed">
                            <UniformGrid Columns="2" Rows="2">
                                <controls:BubbleCard
                                    Margin="0,0,8,8"
                                    Description="{Binding ServiceConnection.Detail}"
                                    Title="{Binding ServiceConnection.Title}">
                                    <controls:StatusBubble
                                        HorizontalAlignment="Left"
                                        Text="状态"
                                        Value="{Binding ServiceConnection.Status}" />
                                </controls:BubbleCard>
                                <controls:BubbleCard
                                    Margin="8,0,0,8"
                                    Description="{Binding CurrentRoute.Detail}"
                                    Title="{Binding CurrentRoute.Title}">
                                    <controls:StatusBubble
                                        HorizontalAlignment="Left"
                                        Text="状态"
                                        Value="{Binding CurrentRoute.Status}" />
                                </controls:BubbleCard>
                                <controls:BubbleCard
                                    Margin="0,8,8,0"
                                    Description="{Binding LocalNetwork.Detail}"
                                    Title="{Binding LocalNetwork.Title}">
                                    <controls:StatusBubble
                                        HorizontalAlignment="Left"
                                        Text="状态"
                                        Value="{Binding LocalNetwork.Status}" />
                                </controls:BubbleCard>
                                <controls:BubbleCard
                                    Margin="8,8,0,0"
                                    Description="{Binding AccelerationEngine.Detail}"
                                    Title="{Binding AccelerationEngine.Title}">
                                    <controls:StatusBubble
                                        HorizontalAlignment="Left"
                                        Text="状态"
                                        Value="{Binding AccelerationEngine.Status}" />
                                </controls:BubbleCard>
                            </UniformGrid>

                            <controls:BubbleCard
                                Margin="0,16,0,0"
                                Description="自动修复只处理托管核心、托管代理、托管 TUN 和当前有效配置。"
                                Title="安全修复">
                                <StackPanel>
                                    <WrapPanel>
                                        <controls:PillButton
                                            AutomationProperties.Name="重新检查诊断"
                                            Click="RefreshDiagnostics_Click"
                                            Content="重新检查"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                        <controls:PillButton
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="一键修复"
                                            Click="RepairDiagnostics_Click"
                                            Content="一键修复"
                                            IsEnabled="{Binding CanRepair}" />
                                        <controls:PillButton
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="打开诊断详细信息"
                                            Click="ToggleDiagnosticDetails_Click"
                                            Content="打开详细信息"
                                            Style="{DynamicResource ManagedSecondaryPillButtonStyle}" />
                                        <controls:PillButton
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="导出脱敏诊断包"
                                            Click="ExportDiagnostics_Click"
                                            Content="导出诊断包"
                                            IsEnabled="{Binding CanExport}"
                                            Style="{DynamicResource ManagedSecondaryPillButtonStyle}" />
                                    </WrapPanel>
                                    <Border
                                        x:Name="DiagnosticDetails"
                                        Margin="0,14,0,0"
                                        Padding="14,12"
                                        Background="{DynamicResource ManagedBrushBgBubble}"
                                        CornerRadius="{DynamicResource ManagedRadiusMedium}"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Style="{DynamicResource ManagedSecondaryTextStyle}"
                                            Text="{Binding Summary}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{DynamicResource ManagedSecondaryTextStyle}"
                                        Text="不会删除账号、本地节点或经典订阅。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </controls:BubbleCard>
                        </StackPanel>

                        <StackPanel
                            x:Name="SettingsSection"
                            Visibility="Collapsed">
                            <controls:BubbleCard
                                Description="这些偏好只影响当前 Windows 用户的 NetAccel。"
                                Title="常用">
                                <StackPanel>
                                    <CheckBox
                                        x:Name="AutoRunCheckBox"
                                        Margin="0,0,0,10"
                                        AutomationProperties.Name="开机后自动打开"
                                        Content="开机后自动打开"
                                        IsChecked="{Binding AutoRun, Mode=TwoWay}"
                                        Style="{DynamicResource ManagedCheckBoxStyle}" />
                                    <CheckBox
                                        Margin="0,0,0,10"
                                        AutomationProperties.Name="打开后自动加速"
                                        Content="打开后自动加速"
                                        IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                                        Style="{DynamicResource ManagedCheckBoxStyle}" />
                                    <CheckBox
                                        Margin="0,0,0,10"
                                        AutomationProperties.Name="关闭窗口时最小化到托盘"
                                        Content="关闭窗口时最小化到托盘"
                                        IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                        Style="{DynamicResource ManagedCheckBoxStyle}" />
                                    <CheckBox
                                        Margin="0,0,0,10"
                                        AutomationProperties.Name="通知提醒"
                                        Content="通知提醒"
                                        IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"
                                        Style="{DynamicResource ManagedCheckBoxStyle}" />
                                    <CheckBox
                                        Margin="0,0,0,12"
                                        AutomationProperties.Name="使用全局加速"
                                        Content="加速范围：全局加速"
                                        IsChecked="{Binding UseTun, Mode=TwoWay}"
                                        Style="{DynamicResource ManagedCheckBoxStyle}" />
                                    <TextBlock Style="{DynamicResource ManagedSecondaryTextStyle}" Text="主题" />
                                    <ComboBox
                                        x:Name="ThemeSelector"
                                        Margin="0,6,0,12"
                                        AutomationProperties.Name="主题"
                                        SelectedValue="{Binding Theme, Mode=TwoWay}"
                                        SelectedValuePath="Tag"
                                        Style="{DynamicResource ManagedComboBoxStyle}">
                                        <ComboBoxItem Content="跟随系统" Tag="system" />
                                        <ComboBoxItem Content="浅色" Tag="light" />
                                        <ComboBoxItem Content="深色" Tag="dark" />
                                    </ComboBox>
                                    <TextBlock
                                        Style="{DynamicResource ManagedSecondaryTextStyle}"
                                        Text="语言：简体中文" />
                                    <controls:PillButton
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="保存设置"
                                        Click="SaveSettings_Click"
                                        Content="保存设置"
                                        IsEnabled="{Binding CanAct}" />
                                </StackPanel>
                            </controls:BubbleCard>

                            <controls:BubbleCard
                                Margin="0,16,0,0"
                                Description="退出登录会先安全停止托管连接，再清除账号凭据。"
                                Title="账号和设备">
                                <StackPanel>
                                    <controls:StatusBubble
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Text="账号"
                                        Value="{Binding AccountText}" />
                                    <controls:StatusBubble
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Text="设备"
                                        Value="{Binding DeviceText}" />
                                    <controls:StatusBubble
                                        HorizontalAlignment="Left"
                                        Text="最后同步"
                                        Value="{Binding LastSyncText}" />
                                    <controls:PillButton
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="退出登录"
                                        Click="Logout_Click"
                                        Content="退出登录"
                                        IsEnabled="{Binding CanAct}"
                                        Style="{DynamicResource ManagedSecondaryPillButtonStyle}" />
                                </StackPanel>
                            </controls:BubbleCard>

                            <controls:BubbleCard
                                Margin="0,16,0,0"
                                Description="仅安装通过 NetAccel 发布签名和 SHA-256 校验的更新。"
                                Title="更新">
                                <StackPanel>
                                    <controls:StatusBubble
                                        x:Name="CurrentVersionStatus"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Text="当前版本"
                                        Value="--" />
                                    <controls:StatusBubble
                                        HorizontalAlignment="Left"
                                        Text="更新渠道"
                                        Value="stable" />
                                    <controls:StatusBubble
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Text="更新状态"
                                        Value="{Binding UpdateText}" />
                                    <controls:PillButton
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="检查并安装安全更新"
                                        Click="InstallUpdate_Click"
                                        Content="检查更新"
                                        IsEnabled="{Binding CanAct}" />
                                </StackPanel>
                            </controls:BubbleCard>

                            <Expander
                                x:Name="AdvancedSettingsExpander"
                                Margin="0,16,0,0"
                                AutomationProperties.Name="高级设置"
                                Header="高级"
                                IsExpanded="False">
                                <controls:BubbleCard
                                    Margin="0,10,0,0"
                                    Description="仅在排查问题或使用经典功能时打开。"
                                    Title="高级工具">
                                    <StackPanel>
                                        <WrapPanel>
                                            <controls:PillButton
                                                AutomationProperties.Name="打开经典模式"
                                                Click="OpenClassicMode_Click"
                                                Content="打开经典模式"
                                                IsEnabled="{Binding CanAct}" />
                                            <controls:PillButton
                                                Margin="8,0,0,0"
                                                AutomationProperties.Name="恢复系统代理"
                                                Click="RestoreSystemProxy_Click"
                                                Content="恢复系统代理"
                                                IsEnabled="{Binding CanAct}"
                                                Style="{DynamicResource ManagedSecondaryPillButtonStyle}" />
                                            <controls:PillButton
                                                Margin="8,0,0,0"
                                                AutomationProperties.Name="打开数据目录"
                                                Click="OpenDataDirectory_Click"
                                                Content="打开数据目录"
                                                Style="{DynamicResource ManagedSecondaryPillButtonStyle}" />
                                        </WrapPanel>
                                        <TextBlock
                                            Margin="0,12,0,0"
                                            Style="{DynamicResource ManagedSecondaryTextStyle}"
                                            Text="本地代理详情和核心版本仅在经典模式或详细诊断中显示。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </controls:BubbleCard>
                            </Expander>

                            <Border
                                Margin="0,16,0,0"
                                Padding="14,12"
                                Background="{DynamicResource ManagedBrushBgBubble}"
                                CornerRadius="{DynamicResource ManagedRadiusMedium}">
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Style="{DynamicResource ManagedSecondaryTextStyle}"
                                    Text="{Binding Summary}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <controls:BubbleCard
                            x:Name="PlaceholderSection"
                            Description="页面结构已经预留，具体功能将在后续 R3 子任务中接入。"
                            Title="正在准备"
                            Visibility="Collapsed">
                            <TextBlock
                                Style="{DynamicResource ManagedBodyTextStyle}"
                                Text="这里会保持简洁，只展示完成当前任务需要的信息。" />
                        </controls:BubbleCard>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <local:ManagedLoginView
            x:Name="LoginView"
            Grid.Row="1" />

        <tb:TaskbarIcon
            x:Name="ManagedTray"
            IconSource="pack://application:,,,/NetAccel;component/Resources/NotifyIcon1.ico"
            NoLeftClickDelay="True"
            ToolTipText="NetAccel"
            TrayMouseDoubleClick="ManagedTray_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu AutomationProperties.Name="NetAccel 托盘菜单">
                    <MenuItem
                        x:Name="TrayHeader"
                        AutomationProperties.Name="状态标题"
                        Header="NetAccel · 未加速"
                        IsEnabled="False" />
                    <Separator />
                    <MenuItem
                        x:Name="TrayPrimaryAction"
                        AutomationProperties.Name="一键加速"
                        Click="TrayPrimaryAction_Click"
                        Header="一键加速" />
                    <MenuItem
                        x:Name="TrayCurrentRoute"
                        AutomationProperties.Name="当前线路"
                        Header="当前线路：智能通道"
                        IsEnabled="False"
                        Visibility="Collapsed" />
